#!/bin/sh
# Rejects commit messages whose header does not follow Conventional Commits.
# Enable with: git config core.hooksPath .githooks

header=$(head -n 1 "$1")

case "$header" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [^ ].{0,99}$'

if ! printf '%s' "$header" | grep -Eq "$pattern"; then
  echo "commit-msg: header must follow Conventional Commits, e.g. 'feat(rag): add SGK chunker'" >&2
  echo "  got: $header" >&2
  echo "  see CONTRIBUTING.md" >&2
  exit 1
fi
