# Copy to .env on the VM (chmod 600). Never commit .env. Comments stay on their own lines.

# Domain Caddy gets HTTPS for; until a domain is bought use <VM IP with dashes>.sslip.io
DOMAIN=edugen.example.id.vn
# Image tag CI pushed: dev, main, or sha-<commit>
TAG=main

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32 (at least 32 characters; APP_ENV=prod refuses the dev secret)
JWT_SECRET=

# Demo: Gemini for generation, embeddings and matrix reading (compose also pins these for the backend)
LLM_PROVIDER=gemini
EMBEDDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Question generator thinking level: minimal | low | medium (default) | high; "default" sends no thinking config
GEMINI_THINKING=medium
MATRIX_GEMINI_MODEL=gemini-3.5-flash-lite
# Qdrant Cloud cluster in GCP asia-southeast1, same region as the VM (required: the image has no local index)
QDRANT_URL=
QDRANT_API_KEY=

# First school and admin, created once by the `seed` service (no-op if they already exist)
SEED_SCHOOL_CODE=
SEED_SCHOOL_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
