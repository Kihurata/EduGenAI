# One origin for the whole app: Caddy gets the Let's Encrypt certificate for $DOMAIN and redirects HTTP to HTTPS.
# The API and health check go to the backend; everything else is the React app (its nginx falls back to index.html).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	request_body /api/* {
		max_size 25MB  # backend limit is MAX_UPLOAD_MB=20
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
