# DATABASE_URL (tuỳ chọn): bỏ trống/comment thì dùng mặc định dev trong
# app/core/config.py, khớp docker-compose.yml: user, password và db đều là
# "edugen", host "localhost", cổng 5433. Cần giá trị khác thì bỏ comment và
# điền dạng: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
ANTHROPIC_API_KEY=
# Gemini cho bộ sinh câu (T-036); LLM_PROVIDER=gemini để dùng Gemini cả khi có ANTHROPIC_API_KEY
GEMINI_API_KEY=
# Bộ nhúng (T-048, D-011): gemini (mặc định, dùng GEMINI_API_KEY) hoặc bge-m3 (cần uv sync --extra embed). Đổi bộ nhúng thì phải ingest lại.
EMBEDDER=gemini
# Qdrant Cloud/server (T-049, D-012): để trống thì dùng chỉ mục nhúng qdrant_data/. Đổi nơi lưu thì phải ingest lại vào đó.
QDRANT_URL=
QDRANT_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
# Đọc ảnh ma trận: lần đầu bằng MATRIX_GEMINI_MODEL, lệch (12/4/6, cột Tổng) thì đọc lại bằng MATRIX_GEMINI_RETRY_MODEL
# MATRIX_GEMINI_MODEL=gemini-3.5-flash-lite
# MATRIX_GEMINI_RETRY_MODEL=gemini-3.8-flash
# Cùng file ma trận tải lại thì dùng kết quả đã lưu (bảng matrix_conversions), không gọi Gemini; false = luôn gọi
# MATRIX_CACHE_ENABLED=true
# Google API key cho marker --use_llm (Gemini)
GOOGLE_API_KEY=
# OCR của marker: llamacpp (cài: winget install ggml.llamacpp) thay cho vLLM/Docker
SURYA_INFERENCE_BACKEND=llamacpp
LLAMA_CPP_BINARY=
# Khác "dev" (vd production) thì bắt buộc JWT_SECRET >= 32 ký tự: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_ENV=dev
# JWT_SECRET=<chuoi-ngau-nhien-dai>
# Thời gian sống của access token, tính bằng phút
# ACCESS_TOKEN_MINUTES=30
# Thời gian sống của refresh token, tính bằng ngày
# REFRESH_TOKEN_DAYS=14
# Số vòng lặp khi băm mật khẩu
# PASSWORD_HASH_ITERATIONS=600000
# Chặn dò mật khẩu và giới hạn upload
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
MAX_UPLOAD_MB=20
# File kết quả mẫu cho RAG giả lập; để trống thì dùng RAG thật
# RAG_MOCK_SAMPLES=
# Thư mục lưu file tải lên và kết quả xuất
# STORAGE_DIR=storage
# File cấu hình cho marker
# MARKER_CONFIG_PATH=marker_config.json
# Thời gian tối đa chờ marker, tính bằng giây
# MARKER_TIMEOUT_SECONDS=600.0
# Các origin frontend được phép gọi API, theo định dạng JSON
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Dựng RAG (nạp bộ nhúng) lúc khởi động ở luồng nền; đặt false để tắt
# RAG_WARMUP=true
